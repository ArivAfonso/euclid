# Use the public npm registry for this repository.
# Mirror registries rewrite every "resolved" URL in package-lock.json and CI
# builds then depend on mirror-only artifacts (this broke CI once: the phantom
# "euclid@2.3.0" / "@types/euclid" / "eve-euclid@0.5.0" packages were purged
# from npmmirror and "npm ci" failed with 404s).
registry=https://registry.npmjs.org/

# NPM Workspace settings
legacy-peer-deps=true