#!/bin/sh
# Pre-push hook — runs the web E2E suite (~4-5 min) before code leaves the machine.
#
# Enabled per clone with:  npm run setup:hooks
#
# Skip for one push:
#   - full bypass:   git push --no-verify
#   - E2E only:      SKIP_E2E=1 git push   (unit tests still ran at commit time)
set -e

if [ "$SKIP_E2E" = "1" ]; then
  echo "[pre-push] SKIP_E2E=1 — skipping the E2E suite."
  exit 0
fi

echo "[pre-push] Running web E2E tests (Playwright)..."
npm run test:e2e
echo "[pre-push] E2E tests passed."
