{
  "name": "@euclid/desktop",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ArivAfonso/euclid"
  },
  "keywords": [
    "Vue3",
    "fabric.js",
    "Typescript"
  ],
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build && electron-builder",
    "build:web": "vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "preview": "electron-vite preview",
    "deploy": "bash deploy.sh",
    "templates:index": "node scripts/index-templates.js"
  },
  "build": {
    "appId": "com.euclid.app",
    "electronVersion": "28.3.3",
    "productName": "Euclid",
    "directories": {
      "output": "release/${version}"
    },
    "publish": {
      "provider": "github",
      "repo": "euclid",
      "private": false
    },
    "files": [
      "dist",
      "out",
      "public/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Euclid",
      "runAfterFinish": true,
      "license": "build/license.txt"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@pixi/webworker": "^7.3.2",
    "@tanstack/vue-table": "^8.21.3",
    "@types/katex": "^0.16.7",
    "@vueuse/core": "^10.11.1",
    "@vueuse/shared": "^10.11.0",
    "axios": "^1.7.2",
    "beautify-qrcode": "^1.0.3",
    "changedpi": "^1.0.4",
    "chroma-js": "^2.4.2",
    "class-variance-authority": "^0.7.1",
    "clipboard": "^2.0.11",
    "clipper-lib": "^6.4.2",
    "clsx": "^2.1.1",
    "core-js": "^3.37.1",
    "crypto-js": "^4.2.0",
    "delaunator": "^5.0.1",
    "dexie": "^3.2.7",
    "driver.js": "^1.8.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "euclid": "^2.3.0",
    "fabric": "^6.4.1",
    "file-saver": "^2.0.5",
    "gifler": "^0.1.0",
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.11.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.23",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^0.544.0",
    "mousetrap": "^1.6.5",
    "nanoid": "^5.0.3",
    "number-precision": "^1.6.0",
    "opentype.js": "^1.3.4",
    "pako": "^2.1.0",
    "perfect-freehand": "^1.2.0",
    "pinia": "^2.1.7",
    "pixi-filters": "^5.1.0",
    "pptxgenjs": "^4.0.1",
    "pptxtojson": "^1.7.0",
    "reka-ui": "^2.5.1",
    "simple-icons": "^15.19.0",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tinycolor2": "^1.6.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.4.30",
    "vue-router": "^4.4.0",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@euclid/eslint-config": "*",
    "@euclid/typescript-config": "*",
    "@types/chroma-js": "^2.4.3",
    "@types/clipboard": "^2.0.7",
    "@types/crypto-js": "^4.2.1",
    "@types/delaunator": "^5.0.2",
    "@types/euclid": "^2.3.9",
    "@types/file-saver": "^2.0.7",
    "@types/hammerjs": "^2.0.45",
    "@types/lodash-es": "^4.17.12",
    "@types/mousetrap": "^1.6.15",
    "@types/opentype.js": "^1.3.8",
    "@types/pako": "^2.0.3",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "autoprefixer": "^10.4.19",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.18.1",
    "less": "^4.2.0",
    "less-loader": "^11.1.4",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "prettier": "^2.8.8",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "1.63.6",
    "sass-loader": "13.3.2",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-webpack-plugin": "^3.3.0",
    "svg-sprite-loader": "^6.0.11",
    "tailwindcss": "^3.4.4",
    "typescript": "^4.9.5",
    "unplugin-auto-import": "^0.16.7",
    "unplugin-vue-components": "^0.25.2",
    "vite": "^5.4.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^1.8.22"
  }
}
